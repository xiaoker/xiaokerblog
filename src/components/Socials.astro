---
import { SOCIALS } from "@/constants";
import LinkButton from "./LinkButton.astro";
---

<div class="flex flex-wrap items-center gap-1">
  {
    SOCIALS.map(social => (
      <LinkButton
        href={social.href}
        class="p-2 hover:rotate-6 sm:p-1 social-link"
        title={social.linkTitle}
        data-name={social.name}
        target={social.href.startsWith("http") ? "_blank" : undefined}
        rel={social.href.startsWith("http") ? "noopener noreferrer" : undefined}
      >
        <social.icon class="inline-block size-6 scale-125 fill-transparent stroke-current stroke-2 opacity-90 group-hover:fill-transparent sm:scale-110" />
        <span class="sr-only">{social.linkTitle}</span>
      </LinkButton>
    ))
  }
</div>

<script>
  document.addEventListener("astro:page-load", () => {
    // 优雅的 Toast 提示函数
    function showToast(message) {
      const toast = document.createElement('div');
      toast.textContent = message;
      // 设置 Toast 样式：固定在顶部居中，带有阴影和圆角
      toast.className = 'fixed top-10 left-1/2 -translate-x-1/2 bg-accent text-white px-5 py-2.5 rounded-md shadow-lg transition-all duration-300 z-50 text-sm font-medium opacity-0 translate-y-[-20px]';
      document.body.appendChild(toast);
      
      // 触发动画出现
      requestAnimationFrame(() => {
        toast.classList.remove('opacity-0', 'translate-y-[-20px]');
      });
      
      // 3秒后淡出并移除
      setTimeout(() => {
        toast.classList.add('opacity-0', 'translate-y-[-20px]');
        setTimeout(() => toast.remove(), 300);
      }, 3000);
    }

    const wechatLinks = document.querySelectorAll('.social-link[data-name="WeChat"]');
    wechatLinks.forEach(link => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        const wechatId = "theXiaoker";
        
        navigator.clipboard.writeText(wechatId).then(() => {
          showToast(`微信公众号 "${wechatId}" 已复制！请前往微信搜索关注。`);
        }).catch(err => {
          showToast(`微信公众号: ${wechatId}`);
        });
      });
    });
  });
</script>
