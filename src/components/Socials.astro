---
import { SOCIALS } from "@/constants";
import LinkButton from "./LinkButton.astro";
---

<div class="flex flex-wrap items-center gap-1">
  {
    SOCIALS.map(social => (
      <LinkButton
        href={social.href}
        class="p-2 hover:rotate-6 sm:p-1 social-link"
        title={social.linkTitle}
        data-name={social.name}
        target={social.href.startsWith("http") ? "_blank" : undefined}
        rel={social.href.startsWith("http") ? "noopener noreferrer" : undefined}
      >
        <social.icon class="inline-block size-6 scale-125 fill-transparent stroke-current stroke-2 opacity-90 group-hover:fill-transparent sm:scale-110" />
        <span class="sr-only">{social.linkTitle}</span>
      </LinkButton>
    ))
  }
</div>

<script>
  document.addEventListener("astro:page-load", () => {
    const wechatLinks = document.querySelectorAll('.social-link[data-name="WeChat"]');
    wechatLinks.forEach(link => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        
        // 建议方案：点击直接复制微信号到剪贴板，并给予轻提示
        const wechatId = "xiaoker"; // 这里可以替换成你真实的公众号 ID
        
        navigator.clipboard.writeText(wechatId).then(() => {
          alert(`微信公众号 ID "${wechatId}" 已复制到剪贴板！\n请前往微信搜索关注。`);
        }).catch(err => {
          alert(`微信公众号 ID: ${wechatId}`);
        });
      });
    });
  });
</script>
